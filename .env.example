# Polar payments — copy this file to .env.local and fill in the real values.
# .env.local is gitignored; never commit the real token.

# Organization access token: Polar dashboard → Settings → Developers → New token
POLAR_ACCESS_TOKEN=

# "production" for real checkouts, "sandbox" for testing (sandbox.polar.sh
# has its own separate token and product IDs)
POLAR_SERVER=production

# Product ID of the Starter Pack (Polar dashboard → Products → copy ID).
# /api/checkout sells this when no ?products= param is given.
POLAR_STARTER_PACK_PRODUCT_ID=

# Public origin of the site, used for the post-purchase redirect.
# Leave empty to derive it from the incoming request.
NEXT_PUBLIC_SITE_URL=
